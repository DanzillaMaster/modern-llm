{
  "model": {
    "dim": 256,
    "n_layers": 6,
    "n_heads": 8,
    "n_kv_heads": 2,
    "multiple_of": 64,
    "ffn_dim_multiplier": 1.3,
    "norm_eps": 1e-5,
    "rope_theta": 500000.0,
    "max_seq_len": 256
  },
  "train": {
    "seed": 42,
    "batch_size": 32,
    "seq_len": 256,
    "max_steps": 2000,
    "lr": 1e-3,
    "min_lr": 1e-4,
    "warmup_steps": 100,
    "weight_decay": 0.1,
    "betas": [0.9, 0.95],
    "grad_clip": 1.0,
    "eval_interval": 100,
    "eval_batches": 20,
    "log_interval": 10,
    "overfit_steps": 300
  }
}
